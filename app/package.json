{
  "name": "orbitpage",
  "private": true,
  "version": "4.21.90",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest",
    "test:unit": "vitest run && cd server && npm test -- --run",
    "clean:e2e": "node scripts/clean-e2e.js",
    "test:e2e": "npm run test:e2e:chromium",
    "test:e2e:chromium": "npm run clean:e2e && playwright test --project=chromium",
    "test:e2e:firefox": "npm run clean:e2e && playwright test --project=firefox",
    "test:e2e:webkit": "npm run clean:e2e && playwright test --project=webkit",
    "test:e2e:ci": "npm run test:e2e:chromium && npm run test:e2e:firefox && npm run test:e2e:webkit",
    "test:e2e:ui": "npm run clean:e2e && playwright test --ui --project=chromium",
    "install:hooks": "node scripts/install-hooks.js",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "preview": "vite preview",
    "server": "cd server && npm run serve",
    "server:dev": "cd server && npm run dev",
    "start": "npm run build && npm run server",
    "install:server": "cd server && npm install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@orbitpage/page-schema": "file:packages/page-schema",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@typeform/embed-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "0.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.5.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "minimatch": "^10.2.4",
    "rollup": "^4.60.0",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.12"
  }
}
