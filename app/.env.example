# Copy to .env. The source quick start adds a unique JWT_SECRET.
# Keep .env private and reuse the same secret on later starts.

# Server and storage
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
# DATA_DIR=./data  # Relative paths resolve from app/server.
# JWT_SECRET=  # Required: a private random value of at least 32 characters.
REQUIRE_SETUP_TOKEN=false
UPLOAD_STORAGE_QUOTA_MB=1024
VIDEO_UPLOAD_LIMIT_MB=100
ORBITPAGE_BACKUP_MEDIA_LIMIT_MB=128
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_GRACE_HOURS=24
TZ=UTC
DEMO_MODE=false

# Public URL and networking
PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_SITE_NAME=OrbitPage
SEO_INDEXING=true
BASE_PATH=
# ORBITPAGE_TRUST_PROXY=loopback
# ORBITPAGE_ALLOWED_ORIGINS=https://trusted.example.com
# FRONTEND_URL=http://localhost:8080
ORBITPAGE_API_RATE_LIMIT_MAX=300
ENABLE_HTTPS=false
SSL_PORT=8443

# AI and recovery. SMTP is configured in Newsletter > Settings.
# OPENAI_API_KEY=
OPENAI_PAGE_AGENT_MODEL=gpt-5.6-terra
# ORBITPAGE_SECRET_ENCRYPTION_KEY=  # Defaults to JWT_SECRET.
# NEWSLETTER_SECRET_KEY=  # Defaults to JWT_SECRET.
# RESET_TOKEN=  # Set only during administrator recovery.

# Frontend build settings; rebuild after changing them.
# VITE_BASE_PATH=
# VITE_DEMO_MODE=false
# VITE_ORBITPAGE_HOSTED_MODE=false
